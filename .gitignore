# OS/editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# MATLAB local/session artifacts
*.asv
*.autosave
*.m~
slprj/
*.mex*
*.log
.matlab_pref_tmp/
.matlab_pref_test/

# Large/local test datasets are kept outside Git.
test/
testdata/
manual_qa_samples/*.mat

# Python local artifacts for future ports
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local reports generated during ad-hoc runs
tmp/
temp/
tools/bin/

# Generated distribution package (regenerate via dist/build_dist_package.m)
dist/build/

# MATLAB Compiler project scaffolding (compiler.build.*/Application Compiler
# sometimes writes these into the working folder instead of -OutputDir)
dist/*.prj
dist/PGIXS/
dist/PGIXS_resources/

# Node modules for docs/tools/md_to_docx.js, and the .docx it generates: Word
# rewrites the table-of-contents field on open, so a tracked copy shows up as
# modified whenever anyone reads it. Run `npm run manual` in docs/tools.
node_modules/
package-lock.json
docs/manual_ko.docx
